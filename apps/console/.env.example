# =====================================================
# 环境变量示例文件
# 复制此文件为 .env 并填入实际值
# =====================================================

# 服务监听端口（默认 3456）
PORT=3456

# 数据存储目录（Docker 部署时通过 volume 挂载）
DATA_DIR=./data

# 运营控制台访问密码（设置后访问 console.xiaonuan.me 需要输入）
# 留空则只允许本地（localhost）访问控制台
CONSOLE_PASSWORD=your_password_here
